{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "252",
    "margin": 1
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "245"
  },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": {
    "block_suffix": "\n",
    "color": "255",
    "bold": true
  },
  "h1": { "prefix": "# ", "bold": true },
  "h2": { "prefix": "## " },
  "h3": { "prefix": "### " },
  "h4": { "prefix": "#### " },
  "h5": { "prefix": "##### " },
  "h6": { "prefix": "###### " },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "240", "format": "\n────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[x] ", "unticked": "[ ] " },
  "link": { "color": "252", "underline": true },
  "link_text": { "color": "255", "bold": true },
  "image": { "color": "245", "underline": true },
  "image_text": { "color": "245", "format": "[{{.text}}]" },
  "code": { "color": "255" },
  "code_block": {
    "color": "252",
    "margin": 1,
    "chroma": {
      "text": { "color": "#D0D0D0" },
      "error": { "color": "#D0D0D0" },
      "comment": { "color": "#808080" },
      "comment_preproc": { "color": "#808080" },
      "keyword": { "color": "#D0D0D0" },
      "keyword_reserved": { "color": "#D0D0D0" },
      "keyword_namespace": { "color": "#D0D0D0" },
      "keyword_type": { "color": "#D0D0D0" },
      "operator": { "color": "#D0D0D0" },
      "punctuation": { "color": "#D0D0D0" },
      "name": { "color": "#D0D0D0" },
      "name_builtin": { "color": "#D0D0D0" },
      "name_tag": { "color": "#D0D0D0" },
      "name_attribute": { "color": "#D0D0D0" },
      "name_class": { "color": "#D0D0D0" },
      "name_constant": { "color": "#D0D0D0" },
      "name_decorator": { "color": "#D0D0D0" },
      "name_exception": { "color": "#D0D0D0" },
      "name_function": { "color": "#D0D0D0" },
      "name_other": { "color": "#D0D0D0" },
      "literal": { "color": "#D0D0D0" },
      "literal_number": { "color": "#D0D0D0" },
      "literal_date": { "color": "#D0D0D0" },
      "literal_string": { "color": "#D0D0D0" },
      "literal_string_escape": { "color": "#D0D0D0" },
      "generic_deleted": { "color": "#D0D0D0" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#D0D0D0" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#808080" }
    }
  },
  "table": {},
  "definition_description": { "block_prefix": "  " }
}
